# Environment Configuration Example for ShopSphere

# Server Port
SERVER_PORT=8080

# Spring Active Profile
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopspheredb
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Initial Super Admin Credentials
ADMIN_NAME=ShopSphere Administrator
ADMIN_EMAIL=admin@shopsphere.com
ADMIN_PASSWORD=Admin@123

# AI Chatbot Configuration (Optional - Defaults to 'mock' provider)
# Options: 'mock' (no network, deterministic FAQ responses) or 'gemini' (Google Gemini API)
CHATBOT_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
